{
    "name": "rueda-libre",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "dev": "vite",
        "dev:share": "vite --host",
        "build": "vite build",
        "preview": "vite preview",
        "preview:share": "vite preview --host",
        "typecheck": "tsc --noEmit && tsc --noEmit --project jsconfig.json",
        "check": "biome lint .",
        "format": "biome format --write ."
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.3",
        "@types/node": "^26.6.5",
        "sass": "^1.106.1",
        "typescript": "^7.0.2",
        "vite": "^7.1.12"
    }
}
